# Public content endpoint only; never place admin credentials here.
# Hosted development backend:
EXPO_PUBLIC_WORDPRESS_URL=https://sinisa.alwaysdata.net
# Public UUID from Expo project settings, set in .env.local once created.
# EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Firebase Android configuration: google-services.json at project root (ignored).
# Never put a Firebase service-account private key or Expo access token here.
# For local WordPress, override in .env.local with http://127.0.0.1:9400
# Local Android testing also needs: adb reverse tcp:9400 tcp:9400
