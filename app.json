{
  "expo": {
    "name": "MATINF",
    "slug": "matinf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/matinf-logo.png",
    "scheme": "matinf",
    "userInterfaceStyle": "light",
    "ios": {},
    "android": {
      "package": "com.matinf.demo",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/matinf-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/matinf-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/matinf-logo.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
